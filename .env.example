# Set to your NAS user/group IDs (run `id` over SSH), then rebuild.
PUID=1000
PGID=1000
# Set the NAS LAN address to enable access from your local network.
MAGPIE_BIND_IP=127.0.0.1
MAGPIE_ALLOWED_HOSTS=localhost,127.0.0.1
PICTURES_PATH=./downloads/pictures
MODELS_PATH=./downloads/models
OTHER_PATH=./downloads/other
# true when accessed through an HTTPS reverse proxy
MAGPIE_SECURE_COOKIES=false
MAGPIE_JOB_TIMEOUT=86400

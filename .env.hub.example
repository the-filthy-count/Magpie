# Replace with your NAS LAN address and the output of `id` for your NAS user.
NAS_IP=192.168.1.100
PUID=1000
PGID=1000
# Use existing NAS directories owned by that UID/GID.
CONFIG_PATH=./config
PICTURES_PATH=./downloads/pictures
MODELS_PATH=./downloads/models
OTHER_PATH=./downloads/other
# Set true only when accessing through an HTTPS reverse proxy.
MAGPIE_SECURE_COOKIES=false
